# Copy to .env (git-ignored) and adjust. Absolute paths only.
APPDATA=/opt/appdata
MEDIA1=/mnt/storage1/media
MEDIA2=/mnt/storage2/media

# User the containers run as; create one user for all of them (see docs/server.md)
PUID=1000
PGID=1000
# gid of the docker group, for Homepage's read-only socket access
DOCKER_GID=998

TZ=Europe/Zurich

# Hosts Homepage may be opened from: LAN address and Tailscale address, with port
HOMEPAGE_ALLOWED_HOSTS=192.0.2.10:3000,100.64.0.10:3000
